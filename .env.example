# IAURA intelligence
OPENAI_API_KEY=
OPENAI_MODEL=

# VAEORA Creative Studio (optional overrides)
OPENAI_CREATIVE_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Paid generation is enabled automatically only in development/test.
# Production fails closed unless this exact acknowledgement is set after
# configuring a provider hard-spend budget and an atomic distributed limiter
# or API gateway. The app's in-memory quotas are defense in depth only.
VAEORA_CREATIVE_PRODUCTION_GUARD=

# Explicit comma-separated browser origins allowed to call Creative Studio.
# Same-origin requests are always accepted. Add the current LAN origin for
# device testing (including its port), plus staging/production as needed.
# Example: http://YOUR-LAN-IP:3001,https://staging.example.com
VAEORA_ALLOWED_ORIGINS=

# Aura Prime voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Private beta access (use a unique value with at least 10 characters)
IAURA_ACCESS_KEY=
